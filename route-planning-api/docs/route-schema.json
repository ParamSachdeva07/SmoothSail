        "draftM": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draftm"
        },
        "airDraftM": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Airdraftm"
        },
        "iceClass": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
