{
  "$defs": {
    "CanalTransit": {
      "additionalProperties": false,
      "properties": {
        "canalId": {
          "title": "Canalid",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "entryTime": {
          "format": "date-time",
          "title": "Entrytime",
          "type": "string"
        },
        "transitStartTime": {
          "format": "date-time",
          "title": "Transitstarttime",
          "type": "string"
        },
        "exitTime": {
          "format": "date-time",
          "title": "Exittime",
          "type": "string"
        },
        "waitingHours": {
          "title": "Waitinghours",
          "type": "number"
        },
        "transitHours": {
          "title": "Transithours",
          "type": "number"
        },
        "tollUsd": {
          "title": "Tollusd",
          "type": "number"
        },
        "serviceAllowanceUsd": {
          "title": "Serviceallowanceusd",
          "type": "number"
        },
        "tariff": {
          "additionalProperties": true,
          "title": "Tariff",
          "type": "object"
        },
        "timingBasis": {
          "title": "Timingbasis",
          "type": "string"
        },
        "operationalStatus": {
          "title": "Operationalstatus",
          "type": "string"
        }
      },
      "required": [
        "canalId",
        "name",
        "entryTime",
        "transitStartTime",
        "exitTime",
        "waitingHours",
        "transitHours",
        "tollUsd",
        "serviceAllowanceUsd",
        "tariff",
        "timingBasis",
        "operationalStatus"
      ],
      "title": "CanalTransit",
      "type": "object"
    },
    "ComplianceCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_assessed",
            "limited_screening"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "missingData": {
          "items": {
            "type": "string"
          },
          "title": "Missingdata",
          "type": "array"
        }
      },
      "required": [
        "id",
        "status",
        "evidence",
        "missingData"
      ],
      "title": "ComplianceCheck",
      "type": "object"
    },
    "ComplianceHandoff": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not_assessed",
          "default": "not_assessed",
          "title": "Status",
          "type": "string"
        },
        "decision": {
          "default": null,
          "title": "Decision",
          "type": "null"
        },
        "declaredContext": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComplianceInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "declarationStatus": {
          "enum": [
            "user_provided_unverified",
            "not_provided"
          ],
          "title": "Declarationstatus",
          "type": "string"
        },
        "declarationsUsedForRouting": {
          "default": false,
          "title": "Declarationsusedforrouting",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ComplianceCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "interpretationRules": {
          "items": {
            "type": "string"
          },
          "title": "Interpretationrules",
          "type": "array"
        }
      },
      "required": [
        "declarationStatus",
        "checks",
        "interpretationRules"
      ],
      "title": "ComplianceHandoff",
      "type": "object"
    },
    "ComplianceInput": {
      "additionalProperties": false,
      "description": "Optional user declarations for downstream review; not verified or used to change routing.",
      "properties": {
        "vessel": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeclaredVessel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cargo": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeclaredCargo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parties": {
          "items": {
            "$ref": "#/$defs/DeclaredParty"
          },
          "maxItems": 100,
          "title": "Parties",
          "type": "array"
        },
        "applicableJurisdictions": {
          "items": {
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Applicablejurisdictions",
          "type": "array"
        }
      },
      "title": "ComplianceInput",
      "type": "object"
    },
    "ConditionEvidence": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "status": {
          "enum": [
            "forecast",
            "simulated",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "snapshotId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshotid"
        },
        "missingReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missingreason"
        }
      },
      "required": [
        "value",
        "unit",
        "status"
      ],
      "title": "ConditionEvidence",
      "type": "object"
    },
    "CostBreakdown": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "period": {
          "const": "entire_voyage",
          "default": "entire_voyage",
          "title": "Period",
          "type": "string"
        },
        "fuelTonnes": {
          "title": "Fueltonnes",
          "type": "number"
        },
        "fuelUsd": {
          "title": "Fuelusd",
          "type": "number"
        },
        "fuelUsdPerTonne": {
          "title": "Fuelusdpertonne",
          "type": "number"
        },
        "averageFuelTonnesPerDay": {
          "title": "Averagefueltonnesperday",
          "type": "number"
        },
        "averageFuelUsdPerDay": {
          "title": "Averagefuelusdperday",
          "type": "number"
        },
        "timeUsd": {
          "title": "Timeusd",
          "type": "number"
        },
        "canalTollsUsd": {
          "title": "Canaltollsusd",
          "type": "number"
        },
        "canalServiceAllowanceUsd": {
          "title": "Canalserviceallowanceusd",
          "type": "number"
        },
        "totalUsd": {
          "title": "Totalusd",
          "type": "number"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "modelId": {
          "title": "Modelid",
          "type": "string"
        },
        "excludedCosts": {
          "items": {
            "type": "string"
          },
          "title": "Excludedcosts",
          "type": "array"
        }
      },
      "required": [
        "fuelTonnes",
        "fuelUsd",
        "fuelUsdPerTonne",
        "averageFuelTonnesPerDay",
        "averageFuelUsdPerDay",
        "timeUsd",
        "canalTollsUsd",
        "canalServiceAllowanceUsd",
        "totalUsd",
        "basis",
        "modelId",
        "excludedCosts"
      ],
      "title": "CostBreakdown",
      "type": "object"
    },
    "CoverageMetric": {
      "additionalProperties": false,
      "properties": {
        "knownHours": {
          "title": "Knownhours",
          "type": "number"
        },
        "unknownHours": {
          "title": "Unknownhours",
          "type": "number"
        },
        "percent": {
          "title": "Percent",
          "type": "number"
        }
      },
      "required": [
        "knownHours",
        "unknownHours",
        "percent"
      ],
      "title": "CoverageMetric",
      "type": "object"
    },
    "DeclaredCargo": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "hsCodes": {
          "items": {
            "pattern": "^\\d{6,10}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Hscodes",
          "type": "array"
        },
        "unNumbers": {
          "items": {
            "pattern": "^UN\\d{4}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Unnumbers",
          "type": "array"
        },
        "originCountryCode": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origincountrycode"
        },
        "destinationCountryCode": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destinationcountrycode"
        }
      },
      "title": "DeclaredCargo",
      "type": "object"
    },
    "DeclaredParty": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "owner",
            "beneficial_owner",
            "operator",
            "charterer",
            "shipper",
            "consignee",
            "other"
          ],
