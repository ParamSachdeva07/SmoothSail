TIDELINE_MODE=demo
MONGODB_URI=mongodb://localhost:27019
MONGODB_PASSWORD=
MONGODB_DB=tideline
API_PORT=8765
BACKEND_URL=http://127.0.0.1:8765
DATA_DIR=./data
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
# true: refresh bounded global/regional forecasts in the background every 6h;
# retain two snapshots per dataset/region. Route requests use existing caches.
AUTO_REFRESH_FORECASTS=false
AISSTREAM_API_KEY=
ROUTE_TIMEOUT_SECONDS=45
# Server-only shared secret for Cloudflare scheduled refresh; deployment creates it.
TIDELINE_INTERNAL_TOKEN=
# Server-only. Without a key, congestion returns unknown immediately.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
COMPLIANCE_CALLS_PER_HOUR=60
COMPLIANCE_CONCURRENCY=6
COMPLIANCE_MAX_ANALYSES=2
# Full context is rejected explicitly above this size; it is never truncated.
COMPLIANCE_MAX_CONTEXT_BYTES=3000000
CONGESTION_CALLS_PER_HOUR=20
