TIDELINE_MODE=demo
MONGODB_URI=mongodb://localhost:27019
MONGODB_PASSWORD=
MONGODB_DB=tideline
API_PORT=8765
BACKEND_URL=http://127.0.0.1:8765
DATA_DIR=./data
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
# true: refresh bounded global/regional forecasts in the background every 6h;
# retain two snapshots per dataset/region. Route requests use existing caches.
AUTO_REFRESH_FORECASTS=false
AISSTREAM_API_KEY=
ROUTE_TIMEOUT_SECONDS=45
# Server-only shared secret for Cloudflare scheduled refresh; deployment creates it.
TIDELINE_INTERNAL_TOKEN=
